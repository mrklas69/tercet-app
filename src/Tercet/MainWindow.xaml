<Window x:Class="Tercet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Tercet"
        Title="{x:Static local:ApplicationIdentity.DisplayName}"
        Icon="{StaticResource ApplicationIcon}"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="False"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!-- Neprůhledné WPF okno uvnitř nativního layered obalu DesktopHost.
         AllowsTransparency zde nefungovalo při skládání plochy v RDP.
         QueueView vytvoří code-behind z aktuálních řádků dokumentu. -->
</Window>
