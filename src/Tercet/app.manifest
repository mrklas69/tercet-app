<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="Tercet.app" />
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10/11: bez deklarace kompatibility Windows nepodporují
           layered child HWND. Samotné nastavení WS_EX_LAYERED nestačí.
           https://learn.microsoft.com/windows/win32/winmsg/using-windows -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- Režim musí platit už před vznikem prvního HWND. Explorer je
           per-monitor-aware; pozdní změna při SetParent jinak resetuje DPI
           procesu, rozbije převody a znovu vyvolává obnovu.
           PerMonitor v1 je zde záměrně: tato varianta prošla měřením
           shody WPF/nativních rozměrů a ustáleného běhu v Exploreru. -->
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitor</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
