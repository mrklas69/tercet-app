<Window x:Class="Tercet.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height"
        Icon="{StaticResource ApplicationIcon}"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!-- Jediná volba: odkaz na frontu, ze kterého se odvodí API
         i token. x:Name vytvoří pole v code-behind (partial class). -->
    <StackPanel Margin="20">
        <TextBlock Text="Queue link" FontWeight="SemiBold" FontSize="16" />
        <TextBlock Margin="0,6,0,8" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Paste your queue link supplied by a compatible queue service (…/Tercet/tercet.html#token). Open Web and Synchronize in the tray menu use it. Leave it empty to keep the queue on this computer only." />
        <TextBox x:Name="LinkBox" />
        <TextBlock x:Name="ErrorText" Margin="0,8,0,0" TextWrapping="Wrap"
                   FontWeight="SemiBold" Visibility="Collapsed" />
        <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <!-- Store odinstalace maže LocalState; záloha musí vzniknout předem. -->
        <TextBlock x:Name="UninstallNotice" Margin="0,16,0,0" TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Text="Uninstalling the Store version deletes its local queue, archive and settings. Before uninstalling, use Back Up Queue… in the tray menu and save the file outside the app's data folder, for example in Documents. Restore Queue… restores it after reinstalling. The backup does not include your server link; keep that separately. Synchronization is not a backup." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="SaveButton" Content="Save" IsDefault="True" Padding="12,5,12,5" />
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Padding="12,5,12,5" Margin="10,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
